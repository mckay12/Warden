{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warden",
  "version": "0.1.0",
  "identifier": "app.warden.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Warden",
        "url": "dashboard.html",
        "width": 960,
        "height": 840,
        "minWidth": 700,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Warden",
    "shortDescription": "Self-imposed adult-content lock for Windows",
    "resources": {
      "../../service/target/release/warden-service.exe": "warden-service.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}