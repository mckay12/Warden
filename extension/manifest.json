{
  "manifest_version": 3,
  "name": "Warden",
  "version": "0.1.0",
  "description": "Self-imposed commitment device that blocks adult content by domain and keyword pattern.",
  "permissions": ["declarativeNetRequest", "nativeMessaging", "alarms"],
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
